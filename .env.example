# ==============================================================================
# MediTrust Environment Configuration Example
# Copy this file to .env.local (development) or .env (production).
# NEVER commit .env or .env.local containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND ONLY (Server-side secrets - NEVER prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------

# Deployer / Operator Private Key (Hex without '0x' or with '0x')
# Source: Exported from your deployer MetaMask account or hardware wallet
PRIVATE_KEY="your_deployer_private_key_here"

# Backend JSON-RPC Endpoint (used by deployment scripts and server-side RPC tasks)
# Source: Alchemy, Infura, QuickNode, or local node (http://127.0.0.1:8545)
RPC_URL="http://127.0.0.1:8545"

# Pinata IPFS Secret JWT (Used for server-side PDF / image evidence upload)
# Source: Pinata Dashboard (https://app.pinata.cloud/developers/api-keys) -> New Key with PinFileToIPFS permissions
PINATA_JWT="your_pinata_jwt_secret_token_here"

# Privy Application Secret (Used for server-side auth verification & session management)
# Source: Privy Dashboard (https://dashboard.privy.io) -> App Settings -> Basics -> App Secret
PRIVY_APP_SECRET="your_privy_app_secret_here"

# Supabase Service Role Key (Bypasses Row Level Security for admin/server-only scans ingestion)
# Source: Supabase Dashboard (https://supabase.com/dashboard) -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# ------------------------------------------------------------------------------
# FRONTEND PUBLIC (Safe to expose to client bundle - Prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------

# Target Blockchain Chain ID (e.g., 31337 for Hardhat Local, 11155111 for Sepolia, 84532 for Base Sepolia)
NEXT_PUBLIC_CHAIN_ID="31337"

# Public Read-Only RPC URL for client-side medicine pack verification
# Source: Public RPC endpoint or Alchemy / Infura public HTTP URL
NEXT_PUBLIC_RPC_URL="http://127.0.0.1:8545"

# Block Explorer Base URL (used for transaction & contract links)
# Source: Etherscan, Blockscout, or Basescan
NEXT_PUBLIC_EXPLORER_URL="https://sepolia.etherscan.io"

# Deployed MediTrust Smart Contract Address
# Source: Output of hardhat deployment script (scripts/deploy.cjs)
NEXT_PUBLIC_CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"

# Privy App ID for Web3 wallet & social login
# Source: Privy Dashboard (https://dashboard.privy.io) -> App Settings -> Basics -> App ID
NEXT_PUBLIC_PRIVY_APP_ID="your_privy_app_id_here"

# Supabase Project URL
# Source: Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anonymous Public API Key (Client-side queries governed by RLS)
# Source: Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Public IPFS Gateway URL for rendering inspection certificates & quarantine evidence
# Source: Pinata Dedicated Gateway or public gateway (e.g., https://gateway.pinata.cloud/ipfs/)
NEXT_PUBLIC_IPFS_GATEWAY="https://gateway.pinata.cloud/ipfs/"
