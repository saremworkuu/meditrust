    "chai": "^4.5.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.17.0",
    "express": "^4.21.2",
    "grammy": "^1.46.0",
    "hardhat": "^2.22.18",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pngjs": "^7.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "viem": "^2.57.18",
    "vite": "^8.3.0"
  },
  "devDependencies": {
