    "test:scores": "tsx test/pharmacyTrustScore.test.ts",
    "test:map": "tsx test/earlyWarningMap.test.ts",
    "test:features": "tsx test/cuttableFeatures.test.ts",
    "seed:recall": "tsx scripts/seedRecallCompliance.ts",
    "seed:warning": "tsx scripts/seedEarlyWarning.ts",
    "seed:demo": "tsx scripts/seedDemoScenario.ts",
    "deploy:contracts": "hardhat --config hardhat.config.cjs run scripts/deploy.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
